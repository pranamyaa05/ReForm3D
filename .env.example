# =============================================================================
# ReForm3D environment configuration
#
# Copy this file to `.env` in the same folder, then fill in real values.
#     copy .env.example .env
# `.env` is git-ignored, so secrets in it never get committed.
#
# Nothing here is hardcoded in the source: the app reads these at startup and
# validates them. See SETUP.md for a walkthrough.
# =============================================================================

# --- Stage 2: Gemini API ------------------------------------------------------
# Your Google AI Studio API key. Required unless USE_MOCK_VLM=true.
# Get one free at: https://aistudio.google.com/apikey  (Create API key)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model id used for classification + measurement extraction.
# Must be a vision-capable model that supports structured output.
# Current flash-tier model as of this writing: gemini-3.8-flash
# (gemini-2.0-flash is shut down). Check
# https://ai.google.dev/gemini-api/docs/models for the current name and override here.
GEMINI_MODEL=gemini-3.8-flash

# Set to true for local development WITHOUT a Gemini key: Stage 2 is then served
# by a deterministic offline stub instead of calling the API. Never use in production.
USE_MOCK_VLM=false

# Number of attempts for a single Gemini call (includes the first try).
GEMINI_MAX_ATTEMPTS=3

# Base seconds for exponential backoff between retries (retry n waits base * 2^n).
GEMINI_RETRY_BASE_DELAY_S=1.5

# Hard timeout for a single Gemini request, in seconds.
GEMINI_REQUEST_TIMEOUT_S=120

# Max output tokens for the structured diagnosis response.
GEMINI_MAX_OUTPUT_TOKENS=4096

# Sampling temperature. Low keeps measurement estimates stable and repeatable.
GEMINI_TEMPERATURE=0.2

# --- Stage 1.5: image enhancement toggle -------------------------------------
# Master on/off switch. Set to false if rembg is slow/unavailable; the pipeline
# then falls back gracefully to the raw images.
ENABLE_IMAGE_ENHANCEMENT=true

# rembg segmentation model name. 'u2netp' is the ~4 MB lightweight variant;
# 'u2net' is ~176 MB and more accurate; 'isnet-general-use' is ~169 MB.
# Downloads on first use into ~/.u2net/ (see SETUP.md for disk/RAM notes).
REMBG_MODEL=u2netp

# CLAHE exposure fix: contrast clip limit and tile grid size (deterministic only).
CLAHE_CLIP_LIMIT=2.0
CLAHE_TILE_GRID_SIZE=8

# --- Stage 1: scale reference & quality-check thresholds ---------------------
# Known diameter (mm) for the 'coin' reference preset (default 24.26 = US quarter).
# Override for other currencies (e.g. 23.25 for 1 EUR, 25.00 for 5 INR).
COIN_DIAMETER_MM=24.26

# Blur: variance of the Laplacian on the greyscale image. Below this => "blurry".
# Higher = stricter. ~100 is a reasonable default for phone photos.
BLUR_THRESHOLD=100.0

# Exposure: mean greyscale luminance window (0-255) considered acceptable.
# Outside the window the image is judged too dark / too bright.
MIN_MEAN_LUMINANCE=40.0
MAX_MEAN_LUMINANCE=220.0

# Fraction of pixels allowed to be fully clipped (0 or 255) before flagging.
MAX_CLIPPED_PIXEL_RATIO=0.05

# Fraction of pixels allowed to be near-black (luma < 15) before flagging.
MAX_UNDEREXPOSED_PIXEL_RATIO=0.35

# If mean luminance is outside the acceptable window by more than this many
# 0-255 levels, the image is flagged as "needs enhancement" (drives whether
# Stage 1.5 applies CLAHE to it).
EXPOSURE_ENHANCEMENT_MARGIN=8.0

# Reference-visibility check: minimum fraction of the user-marked bounding box
# that must be covered by the detected reference contour for the check to pass.
MIN_REFERENCE_BOX_COVERAGE=0.25

# --- Stage 1.5: reference-retention gate --------------------------------------
# After background removal, the mean alpha inside the user-marked reference box
# must be at least this fraction of the pre-removal value. Below it, the reference
# is considered clipped and the pipeline falls back to the unenhanced image.
REFERENCE_RETENTION_MIN_RATIO=0.85

# --- Stage 3: CAD parameters --------------------------------------------------
# Safety clearance added to every mating/bore dimension so the print slides on.
# Sensible range 0.15 - 0.3 mm for FDM. Applied to inner mating surfaces only.
DEFAULT_CLEARANCE_MM=0.20
MIN_CLEARANCE_MM=0.05
MAX_CLEARANCE_MM=0.60

# Reject walls/bodies thinner than this (mm) - below it the part is not printable.
MIN_WALL_THICKNESS_MM=0.80

# Smallest and largest accepted dimension for any measurement (mm). Guards against
# the VLM returning absurd values (0, negatives, or metres).
MIN_DIMENSION_MM=0.5
MAX_DIMENSION_MM=500.0

# Chord tolerance (mm) used when tessellating the solid to STL. Smaller = finer mesh.
STL_TESSELLATION_TOLERANCE_MM=0.05

# Angular tolerance (radians) used when tessellating the solid to STL.
STL_ANGULAR_TOLERANCE_RAD=0.20

# --- Paths --------------------------------------------------------------------
# Uploaded photos and enhanced variants. Created automatically.
UPLOAD_DIR=data/uploads
# Generated STL/STEP files. Created automatically.
OUTPUT_DIR=data/outputs

# --- Server -------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
